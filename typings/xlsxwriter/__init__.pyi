from collections.abc import Mapping, Sequence
from io import BytesIO
from types import TracebackType
from typing import Self

class Format: ...

class Worksheet:
    def hide_gridlines(self, option: int = ...) -> None: ...
    def set_column(self, first_col: int, last_col: int, width: float | None = ..., cell_format: Format | None = ...) -> int: ...
    def write_row(self, row: int, col: int, data: Sequence[object], cell_format: Format | None = ...) -> int: ...
    def set_row(self, row: int, height: float | None = ..., cell_format: Format | None = ...) -> int: ...
    def freeze_panes(self, row: int, col: int) -> None: ...
    def write(self, row: int, col: int, value: object, cell_format: Format | None = ...) -> int: ...
    def write_formula(self, cell: str, formula: str, cell_format: Format | None = ..., value: int | float = ...) -> int: ...
    def data_validation(self, cell: str, options: Mapping[str, object]) -> int: ...
    def conditional_format(self, cell_range: str, options: Mapping[str, object]) -> int: ...
    def set_landscape(self) -> None: ...
    def fit_to_pages(self, width: int, height: int) -> None: ...

class Workbook:
    def __init__(self, filename: BytesIO, options: Mapping[str, object] | None = ...) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, exc_type: type[BaseException] | None, exc_value: BaseException | None, traceback: TracebackType | None) -> None: ...
    def add_format(self, properties: Mapping[str, object] | None = ...) -> Format: ...
    def add_worksheet(self, name: str | None = ...) -> Worksheet: ...
